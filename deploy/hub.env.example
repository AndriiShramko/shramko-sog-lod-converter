# Copy to deploy/hub.env (gitignored) and fill in. deploy.sh, rollback.sh, hub.sh and neighbours.py
# read it as plain KEY=value lines (never sourced): one SOG_* key per line, no inline comments,
# optional quotes. Nothing about the hub (address, SSH port, user, key, paths) is kept in the repo.

# ssh destination (user@host), port and private key
SOG_HOST=user@hub.example
SOG_PORT=22
SOG_KEY=~/.ssh/id_ed25519

# the service directory on the hub (compose.yml, nginx.conf, config.env, api/, data/, releases/)
SOG_BASE=/srv/sog
# where deploy.sh writes sog-predeploy-<UTC>-<release>.tgz before every switch
SOG_BACKUPS=/srv/_backups

# an existing config.env on the hub that already holds TG_BOT_TOKEN and TG_CHAT_ID; only used in
# the command `deploy.sh --init` PRINTS (it copies those two lines, never prints their values)
SOG_TG_CONFIG_SRC=/srv/other-service/config.env

# optional
SOG_PUBLIC_URL=https://sog.flyreelstudio.eu
SOG_KEEP_RELEASES=5
SOG_KEEP_BACKUPS=10
